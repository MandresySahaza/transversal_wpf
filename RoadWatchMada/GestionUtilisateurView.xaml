<UserControl x:Class="RoadWatchMada.GestionUtilisateurView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="TitreStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryColor}"/>
            <Setter Property="Margin" Value="20,10,20,20"/>
        </Style>

        <Style x:Key="BoutonActionStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <Style x:Key="FiltreLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="FiltreTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="FiltreComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel>
            <!-- Titre de l'écran -->
            <TextBlock Text="Gestion des Utilisateurs" Style="{StaticResource TitreStyle}"/>

            <!-- Formulaire de filtres -->
            <Border Background="#FFF8F8F8" 
                    BorderBrush="#FFE0E0E0" 
                    BorderThickness="0,0,0,1"
                    Padding="20,15"
                    Margin="20,0,20,20">
                <StackPanel>
                    <TextBlock Text="Filtres de recherche" 
                              FontWeight="Bold" 
                              Margin="0,0,0,10"
                              Foreground="{StaticResource SecondaryColor}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Nom:" Style="{StaticResource FiltreLabelStyle}" Width="80"/>
                        <TextBox x:Name="txtFiltreNom" 
                                Style="{StaticResource FiltreTextBoxStyle}"
                                />

                        <TextBlock Text="Prénom:" Style="{StaticResource FiltreLabelStyle}" Width="80"/>
                        <TextBox x:Name="txtFiltrePrenom" 
                                Style="{StaticResource FiltreTextBoxStyle}"
                                />

                        <TextBlock Text="Email:" Style="{StaticResource FiltreLabelStyle}" Width="80"/>
                        <TextBox x:Name="txtFiltreEmail" 
                                Style="{StaticResource FiltreTextBoxStyle}"
                                />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Profil:" Style="{StaticResource FiltreLabelStyle}" Width="80"/>
                        <ComboBox x:Name="cmbFiltreProfil" 
                                 Style="{StaticResource FiltreComboBoxStyle}"
                                 >
                            <ComboBoxItem Content="Tous les profils" IsSelected="True"/>
                            <ComboBoxItem Content="Public"/>
                            <ComboBoxItem Content="Responsable"/>
                        </ComboBox>

                        <TextBlock Text="Date de naissance:" Style="{StaticResource FiltreLabelStyle}" Width="120"/>
                        <DatePicker x:Name="dpFiltreDateDebut" 
                                   Margin="0,0,10,0"
                                   Width="120"
                                   ToolTip="Date de naissance début"/>

                        <TextBlock Text="à" Style="{StaticResource FiltreLabelStyle}" Width="20" TextAlignment="Center"/>

                        <DatePicker x:Name="dpFiltreDateFin" 
                                   Margin="0,0,20,0"
                                   Width="120"
                                   ToolTip="Date de naissance fin"/>

                        <Button Content="Réinitialiser" 
                               Style="{StaticResource BoutonActionStyle}"
                               Background="#FF9E9E9E"
                               Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tableau des utilisateurs -->
            <DataGrid x:Name="dgUtilisateurs" 
                     AutoGenerateColumns="False"
                     Margin="20,0,20,20"
                     IsReadOnly="True"
                     HeadersVisibility="Column"
                     SelectionMode="Single"
                     CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="120"/>
                    <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="120"/>
                    <DataGridTextColumn Header="Date Naissance" Binding="{Binding DateNaissance, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="Profil" Binding="{Binding Profil}" Width="100"/>

                    <DataGridTemplateColumn Header="Actions" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Modifier" 
                                           Style="{StaticResource BoutonActionStyle}"
                                           Background="#FF4CAF50"
                                           Foreground="White"
                                           Click="BtnModifier_Click"/>
                                    <Button Content="Supprimer" 
                                           Style="{StaticResource BoutonActionStyle}"
                                           Background="#FFF44336"
                                           Foreground="White"
                                           Click="BtnSupprimer_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Pagination -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="◀◀ Premier" 
                       Click="BtnPremier_Click"
                       Style="{StaticResource BoutonActionStyle}"/>
                <Button Content="◀ Précédent" 
                       Click="BtnPrecedent_Click"
                       Style="{StaticResource BoutonActionStyle}"/>

                <TextBlock Text="Page" VerticalAlignment="Center" Margin="10,0"/>
                <TextBox x:Name="txtPageCourante" 
                        Width="50" 
                        Text="1" 
                        TextAlignment="Center"
                        Margin="5,0"
                        />
                <TextBlock Text="/" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock x:Name="txtTotalPages" 
                          Text="1" 
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>

                <TextBlock x:Name="txtTotalUtilisateurs" 
                          Text="(0 utilisateurs)" 
                          VerticalAlignment="Center"
                          Margin="20,0"
                          FontStyle="Italic"
                          Foreground="Gray"/>

                <Button Content="Suivant ▶" 
                       Click="BtnSuivant_Click"
                       Style="{StaticResource BoutonActionStyle}"/>
                <Button Content="Dernier ▶▶" 
                       Click="BtnDernier_Click"
                       Style="{StaticResource BoutonActionStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>